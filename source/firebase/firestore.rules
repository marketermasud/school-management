rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // অ্যাডমিন = প্রথম সেটআপে যিনি অ্যাকাউন্ট খুলেছেন (owner/main-এ তাঁর uid)
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/owner/main)
        && get(/databases/$(database)/documents/owner/main).data.uid == request.auth.uid;
    }

    // মালিক নির্ধারণ: শুধু একবারই তৈরি করা যায়, পরে আর বদলানো বা মোছা যায় না
    match /owner/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if id == 'main'
        && request.auth != null
        && !exists(/databases/$(database)/documents/owner/main)
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // স্কুলের সব তথ্য: শুধু অ্যাডমিন পড়তে ও লিখতে পারবেন
    match /schools/{school}/{document=**} {
      allow read, write: if isOwner();
    }

    // QR যাচাই: ক্রমিক নং জানলে যে কেউ একটি ডকুমেন্ট দেখতে পারবে, তালিকা দেখা যাবে না
    match /verify/{serial} {
      allow get: if true;
      allow list: if false;
      allow write: if isOwner();
    }

    // বাকি সব বন্ধ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
