rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // সুপার অ্যাডমিন: শুধু এই UID
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'gTelHLOORQWBMkWcUDeTb0ND6du2';
    }

    // অনুমোদিত (সক্রিয়) শিক্ষক
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.status == 'active';
    }

    // শিক্ষকের অ্যাকাউন্ট: নিজে আবেদন করবেন, অনুমোদন/বন্ধ/বার্তা অ্যাডমিন দেবেন
    match /staff/{uid} {
      allow get: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow list: if isOwner();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isOwner();
    }

    // স্কুলের সব তথ্য: অ্যাডমিন সব পারবেন (রিসাইকেল বিন সহ)
    match /schools/{school}/{document=**} {
      allow read, write: if isOwner();
    }

    // শিক্ষক যা দেখতে পারবেন
    match /schools/{school}/{col}/{id} {
      allow read: if isTeacher() && (
        col in ['meta', 'students', 'teachers', 'payments', 'notices', 'exams', 'documents',
                'attendance', 'marks', 'routine', 'counters']
        || (col == 'requests' && resource.data.uid == request.auth.uid)
      );
      allow write: if isTeacher() && (
        col in ['students', 'attendance', 'marks', 'payments', 'documents', 'log', 'counters']
        || (col == 'requests' && request.resource.data.uid == request.auth.uid)
      );
    }

    // QR যাচাই: ক্রমিক নং জানলে যে কেউ একটি ডকুমেন্ট দেখতে পারবে
    match /verify/{serial} {
      allow get: if true;
      allow list: if false;
      allow write: if isOwner() || isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
